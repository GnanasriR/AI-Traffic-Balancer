server:
  port: 8081

spring:
  application:
    name: user-service

  datasource:
    url: jdbc:oracle:thin:@localhost:1521:xe
    username: traffic_user
    password: ${USER_DB_PASSWORD:traffic_pass123}
    driver-class-name: oracle.jdbc.OracleDriver

  jpa:
    database-platform: org.hibernate.dialect.OracleDialect
    hibernate:
      ddl-auto: update
    show-sql: false

app:
  jwt:
    secret: ${JWT_SECRET:aVeryLongAndSecureBase64EncodedSecretKeyForJWTSigningAtLeast256BitsLong}
    expiration-ms: 86400000

eureka:
  client:
    username: ${EUREKA_USER:eureka}
    password: ${EUREKA_PASSWORD:eureka123}
    service-url:
      defaultZone: http://${EUREKA_USER:eureka}:${EUREKA_PASSWORD:eureka123}@localhost:8761/eureka/
    fetch-registry: true
    register-with-eureka: true
  instance:
    prefer-ip-address: true

management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics
  endpoint:
    health:
      show-details: when-authorized

logging:
  level:
    root: INFO
    com.kce.traffic: DEBUG
