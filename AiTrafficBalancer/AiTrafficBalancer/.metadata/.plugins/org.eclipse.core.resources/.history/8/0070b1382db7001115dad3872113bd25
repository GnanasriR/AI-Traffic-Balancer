server:
  port: 8761

spring:
  application:
    name: eureka-server
  security:
    user:
      name: ${EUREKA_USER:eureka}
      password: ${EUREKA_PASSWORD:eureka123}

eureka:
  client:
    register-with-eureka: false
    fetch-registry: false
    service-url:
      defaultZone: http://${EUREKA_USER:eureka}:${EUREKA_PASSWORD:eureka123}@localhost:8761/eureka/

  server:
    enable-self-preservation: true
    peer-node-read-timeout-ms: 10000

---
spring:
  config:
    activate:
      on-profile: dev
eureka:
  server:
    enable-self-preservation: false