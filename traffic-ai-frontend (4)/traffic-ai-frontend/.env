# SignalSync AI Traffic Balancer - Frontend Environment Config
# All frontend traffic routes through Spring Cloud API Gateway (Port 8080)
VITE_GATEWAY_URL=http://localhost:8080

# Microservice endpoints routed through Gateway
VITE_TRAFFIC_WS_URL=ws://localhost:8000/ws/traffic
VITE_ANALYTICS_API_URL=http://localhost:8080
VITE_INCIDENT_API_URL=http://localhost:8080
VITE_AUTH_API_URL=http://localhost:8080
VITE_OPTIMIZER_API_URL=http://localhost:8080
